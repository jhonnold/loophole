{
  "name": "@loophole/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.test.json",
    "test:e2e": "playwright test --grep-invert @perf",
    "test:perf": "playwright test --grep @perf",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts"
  },
  "dependencies": {
    "@loophole/api-client": "workspace:*",
    "@loophole/core": "workspace:*"
  },
  "devDependencies": {
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "vite": "8.3.4"
  }
}
